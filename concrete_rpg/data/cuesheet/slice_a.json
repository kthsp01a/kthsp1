   ],
   "question": {
    "id": "Q00_WHY_DOG",
    "text": "저 개는 왜 여기 있나"
   },
   "hypotheses": [
    {
     "id": "H00_DRIFTED",
     "canon": true,
     "line": "떠내려왔군.",
     "needs": [
