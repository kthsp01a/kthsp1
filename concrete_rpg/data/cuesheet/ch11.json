     "lines": [
      {
       "speaker": "nuri",
       "text": "작은 점의 숨은 가벼웠다. 가벼워서, 끊기기 쉬웠다.",
       "file": "assets/vo/A22/A22_000.opus",
       "t": 3677.858,
