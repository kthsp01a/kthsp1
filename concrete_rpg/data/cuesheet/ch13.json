     "motion": "push_fast",
     "action": "바위를 올라타는 순간",
     "lines": [
      {
       "speaker": "nuri",
       "text": "물길을 피해 바위를 올라타는 순간, 잿빛이 뒤쪽에서 짧게 소리냈다.",
       "file": "assets/vo/A25/A25_014.opus",
