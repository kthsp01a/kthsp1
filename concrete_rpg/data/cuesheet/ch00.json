   "cut": {
    "file": "assets/cut/00.mp4",
    "poster": "assets/cut/00_poster.webp",
    "tc_in": 165.708,
    "tc_out": 196.208,
    "action": "담장 끝의 작은 검은 그림자, 까망 — 위험의 언어",
    "motion": "pan_rl",
    "subs": [
     {
      "speaker": "narrator",
      "text": "담장 끝에서 작은 검은 그림자가 나타났다. 까망이었다. 그녀의 꼬리는 아주 낮게, 아주 천천히 움직였다. 위험.",
      "file": "assets/vo/00/00_014.opus",
      "t": 166.517,
      "dur": 10.362,
      "wid": "00_014",
      "deadline_ms": 300
     },
     {
      "speaker": "narrator",
      "text": "캡틴은 결론을 내렸다. 오늘 밤, 이 골목은 하나를 잃거나— 아니면 아주 드물게, 하나를 얻게 된다.",
